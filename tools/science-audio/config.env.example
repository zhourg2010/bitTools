# 复制成 config.env 再改：cp config.env.example config.env
# config.env 已被 .gitignore 忽略，不会提交（里面可能有 cookie 路径等私密信息）

# ===== 路径 =====
OUTPUT_ROOT="$HOME/ScienceAudio"
# 本工具目录（一般不用改；sync 会自动设 TOOLS_DIR）
# TOOLS_DIR="$HOME/ScienceAudioTools"

# ===== 代理 =====
USE_PROXY=1
# scheme 要跟代理类型对上：HTTP 代理写 http://，SOCKS 代理写 socks5://
PROXY_ADDRESS="http://127.0.0.1:1080"

# ===== 下载限制 =====
MAX_ITEMS_PER_SOURCE=30
MAX_DURATION_SEC_YOUTUBE=2700    # 45 分钟
MAX_DURATION_SEC_PODCAST=3600    # 60 分钟
AUDIO_FORMAT="mp3"
AUDIO_QUALITY="0"

# ===== 分级分目录 =====
# 0 = 扁平存放  $OUTPUT_ROOT/<源名>/         （默认，跟老版本一致）
# 1 = 按分级分  $OUTPUT_ROOT/<分级>/<源名>/
# 已经下过一轮再改成 1 的话，旧目录里的 downloaded.txt 就对不上了，会全量重下。
# 迁移办法见 README「按分级分目录」一节。
GROUP_BY_LEVEL=0

# ===== YouTube cookies =====
# 优先 COOKIES_FILE；为空则用浏览器
# 浏览器可选: safari / chrome / chromium / edge / firefox / brave / opera / vivaldi
COOKIES_FILE=""
COOKIES_FROM_BROWSER="safari"

# ===== 转写 =====
# 用哪个 python 解释器（transcribe.sh 会用它来找 whisper 库）
PYTHON="python3"
# 模型：tiny / base / small / medium / large-v3，也可以填本地模型目录的绝对路径
# 越大越准也越慢；儿童科普用 small 通常够了
MODEL="small"
LANGUAGE="en"          # 不确定语种可设 auto
SKIP_EXISTING_SRT=1    # 已有非空 .srt 就跳过
KEEP_JSON=0            # 1 = 保留 whisper 的中间 json

# ===== sync 开关（1/0）=====
RUN_YOUTUBE=1
RUN_PODCAST=1
RUN_REORGANIZE=1
RUN_TRANSCRIBE=1
