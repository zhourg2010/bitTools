# 复制成 config.env 再改：cp config.env.example config.env
# config.env 已被 .gitignore 忽略，不会提交（里面可能有 cookie 路径等私密信息）

# ===== 路径 =====
OUTPUT_ROOT="$HOME/ScienceAudio"
# 本工具目录（一般不用改；sync 会自动设 TOOLS_DIR）
# TOOLS_DIR="$HOME/ScienceAudioTools"

# ===== 代理 =====
USE_PROXY=1
# 注意 scheme 要跟代理类型对上：SOCKS 代理（常见端口 1080）要写 socks5://，
# 写成 http:// 会连不上
PROXY_ADDRESS="socks5://127.0.0.1:1080"

# ===== 下载限制 =====
MAX_ITEMS_PER_SOURCE=30
MAX_DURATION_SEC_YOUTUBE=2700    # 45 分钟
MAX_DURATION_SEC_PODCAST=3600    # 60 分钟
AUDIO_FORMAT="mp3"
AUDIO_QUALITY="0"

# ===== YouTube cookies =====
# 优先 COOKIES_FILE；为空则用浏览器
# 浏览器可选: safari / chrome / chromium / edge / firefox / brave / opera / vivaldi
COOKIES_FILE=""
COOKIES_FROM_BROWSER="safari"

# ===== 转写 =====
PYTHON="python3"
MODEL="$HOME/Models/faster-whisper-base"
SKIP_EXISTING_SRT=1
LANGUAGE="en"

# ===== sync 开关（1/0）=====
RUN_YOUTUBE=1
RUN_PODCAST=1
RUN_REORGANIZE=1
RUN_TRANSCRIBE=1
